<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <package android:name="com.ts.launcher" />
        <package android:name="com.gathin.tvhome" />
    </queries>
    <!-- An ordinary app-list entry, with no HOME category, permissions, services or boot receiver. -->
    <application android:label="@string/app_name" android:icon="@drawable/entry_icon"
        android:banner="@drawable/entry_banner" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".EntryActivity" android:exported="true"
            android:excludeFromRecents="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
